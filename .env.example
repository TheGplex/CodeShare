# Database (PostgreSQL)
DATABASE_URL="postgresql://codeshare:CHANGE_ME@localhost:5432/codeshare?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave blank to disable)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public discovery list (true / false)
NEXT_PUBLIC_DISCOVER_ENABLED="true"
